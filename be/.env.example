# Copiez ce fichier en .env (jamais commite) ou definissez ces variables sur le serveur.
# ADMIN_KEY : generez une valeur longue et aleatoire, par exemple : openssl rand -hex 32
ADMIN_KEY=remplacez-par-une-valeur-aleatoire
PORT=8080
# Periode gratuite : jusqu'a cette date (incluse), les frais restaurant sont calcules mais factures 0 F.
# Laissez vide ou supprimez la ligne pour facturer des maintenant.
#FRAIS_RESTO_GRATUITS_JUSQUAU=2027-01-31
# Derriere Caddy ou un autre proxy de confiance : lit l'adresse du client dans X-Forwarded-For
# (sert a limiter les tentatives de connexion des restaurants).
#TRUST_PROXY=1
